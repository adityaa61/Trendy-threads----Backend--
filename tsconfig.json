{
  "compilerOptions": {
    "target": "ES2020",                 // Modern JS features
    "module": "commonjs",               // Node.js module system
    "rootDir": "src",                 // TypeScript source files
    "outDir": "dist",                 // Compiled JS output
    "esModuleInterop": true,            // Allows import/export compatibility
    "moduleResolution": "node",
    "strict": true,                     // Type safety
    "skipLibCheck": true,               // Ignore type check in node_modules
    "sourceMap": true,                  // Generate source maps
    "declaration": true,                // Generate type definitions
    "declarationMap": true,             
    "types": ["node"],                  // Include Node.js types
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src"]
}
